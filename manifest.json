{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_description__",
  "version": "4.1.0",
  "default_locale": "en",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "https://*.cybozu.com/*",
    "https://*.kintone.com/*",
    "https://*.cybozu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.cybozu.com/*",
        "https://*.kintone.com/*",
        "https://*.cybozu.cn/*"
      ],
      "js": ["content-scripts/content.js"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "128": "icon.png"
  }
}
